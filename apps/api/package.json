{
  "name": "@appolitica/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && cp -r src/db/migrations dist/db/migrations",
    "start": "node dist/index.js",
    "lint": "oxlint src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "seed:mock": "tsx src/scripts/seed-mock.ts",
    "sync:camara": "tsx src/scripts/sync-camara.ts",
    "sync:senado": "tsx src/scripts/sync-senado.ts",
    "sync": "tsx src/scripts/sync-all.ts",
    "tse:check": "tsx src/scripts/check-tse-updates.ts",
    "tse:ingest": "tsx src/scripts/ingest-tse.ts",
    "test": "node --import tsx --test src/lib/plain-language.test.ts"
  },
  "dependencies": {
    "@appolitica/types": "workspace:*",
    "@hono/node-server": "^1.14.4",
    "bcryptjs": "^3.0.3",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.10",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^24.13.2",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.71.0",
    "tsx": "^4.19.4",
    "typescript": "~6.0.2"
  }
}
